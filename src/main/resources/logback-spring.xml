<?xml version="1.0" encoding="UTF-8"?>
<!--
  结构化日志格式（单行、可 grep、可 awk）：

    2026-10-21T00:12:03.123+08:00 INFO  [a1b2c3d4e5f60718] http.access - method=GET path=/api/menu status=200 ms=12 ip=1.2.3.4 ua="..."

  - `[rid]` 是链路 ID（RequestLoggingFilter 写入 MDC，缺失时显示 `-`），
    与 nginx 的 $request_id 是同一个值，排查时两边用同一个 rid 对齐。
  - 输出到 stdout，由 pm2 落到 /root/.pm2/logs/notelab-java-{out,error}.log，
    再由 pm2-logrotate 按 10M / 保留 30 份轮转。

  为什么不上 JSON encoder：会引入 logstash-logback-encoder 依赖，而当前日志量（单机、单服务）
  用 key=value 单行格式已足够被 ops/logs.sh 精确解析，少一个依赖少一处升级负担。
-->
<configuration>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{reqId:--}] %logger{30} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 访问日志独立 logger：默认 INFO，quiet 模式下也保留（它就是排障主数据） -->
    <logger name="http.access" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
